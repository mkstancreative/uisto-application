# Career-portal API server root — no trailing slash and no /api/v1.
# Leave empty in development to use the Vite proxy below.
# Production example: VITE_API_URL=https://career.uisto.edu.ng
VITE_API_URL=

# Development only: where the Vite dev server proxies /api and /uploads.
# Note: on macOS, port 5000 is taken by AirPlay Receiver — run the API on
# another port (e.g. 5050) or turn AirPlay Receiver off.
VITE_PROXY_TARGET=http://localhost:5000
