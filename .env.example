# Career-portal API server root — no trailing slash and no /api/v1.
# Leave unset to use the deployed API: https://career-portal-uisto.onrender.com
# Set it to an empty value (VITE_API_URL=) to call the same origin through the
# Vite dev proxy below, e.g. when running the API locally.
# VITE_API_URL=https://career-portal-uisto.onrender.com

# Development only, when VITE_API_URL is empty: where /api and /uploads are proxied.
# Note: on macOS, port 5000 is taken by AirPlay Receiver — run a local API on
# another port (e.g. 5050) or turn AirPlay Receiver off.
VITE_PROXY_TARGET=http://localhost:5050
